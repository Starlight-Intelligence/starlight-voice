# Copy to .env.local for local development.
# Never commit .env, .env.local, or real provider keys.

# Core LLM / realtime lanes.
# Voice token order: this XAI_API_KEY when it starts with xai-, then the
# Infisical EU dev secret of the same name. OpenRouter keys are ignored.
# There is no Grok CLI login.
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Premium voice lane
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Voice pipeline lanes
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# LiteLLM gateway. The voice socket does not read these Infisical ids.
# It calls the EU project named in AGENTS.md.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev

# Voice socket. No Grok CLI login. The management key is only read to
# confirm the postpaid spending limit. Never commit it.
STARLIGHT_XVOICE_VOICE=ara
STARLIGHT_XVOICE_REASONING=high
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=
